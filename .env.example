# Copy to .env for local development: cp .env.example .env
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Leave unset locally to use SQLite. On Vercel the Neon Postgres integration sets it.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Stripe test-mode keys. Leave empty locally to use the built-in dev gateway
# (only active when DEBUG=True), which skips the payment page.
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Vercel only: set to 1 to load sample products during the build.
# SEED_PRODUCTS=1
